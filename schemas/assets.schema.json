{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "style": {
      "default": {},
      "type": "object",
      "properties": {
        "ink": {
          "default": "#2b2118",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "paper": {
          "default": "#f4ead2",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "roughness": {
          "default": 1.1,
          "type": "number",
          "minimum": 0,
          "maximum": 4
        }
      },
      "additionalProperties": false
    },
    "auto": {
      "default": true,
      "type": "boolean"
    },
    "entries": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "recipe": {
            "type": "string"
          },
          "params": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "file": {
            "type": "string"
          },
          "w": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "h": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "category",
          "recipe"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
