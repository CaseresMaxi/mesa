{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "default": "0.1.0",
      "type": "string"
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "language": {
      "default": "es",
      "type": "string"
    },
    "players": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "balance": {
      "default": {},
      "type": "object",
      "properties": {
        "games": {
          "default": 300,
          "type": "integer",
          "minimum": 10,
          "maximum": 9007199254740991
        },
        "factionsPerGame": {
          "default": 4,
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "minWinRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxWinRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxAvgTurns": {
          "default": 60,
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "players"
  ],
  "additionalProperties": false
}
