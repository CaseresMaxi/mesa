{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string"
    },
    "terrains": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "icon": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "color"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string"
          },
          "terrain": {
            "type": "string"
          },
          "slots": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "x": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "corner": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "terrain",
          "slots",
          "x",
          "z"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "startCorners": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "center": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "decor": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "name",
    "terrains",
    "nodes",
    "edges",
    "startCorners"
  ],
  "additionalProperties": false
}
