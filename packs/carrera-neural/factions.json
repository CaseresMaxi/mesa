{
  "$schema": "../../schemas/factions.schema.json",
  "factions": [
    {
      "id": "google",
      "name": "Google DeepMind",
      "short": "Google",
      "tagline": "La megacorporación: escala, nube propia y billetera infinita.",
      "color": "#e0a82e",
      "warriors": {
        "count": 20,
        "name": "ingenieros",
        "singular": "ingeniero"
      },
      "building": {
        "kind": "datacenter",
        "name": "Datacenter",
        "count": 6,
        "vp": [
          1,
          2,
          2,
          3,
          3,
          4
        ]
      },
      "actions": 3,
      "recruit": null,
      "move": {
        "range": 1,
        "needsRule": true
      },
      "battle": {
        "maxDice": 3
      },
      "special": {
        "name": "Adquirir",
        "hint": "Elegí un mercado que lideres con ingenieros y rivales: comprás 1 agente del rival más fuerte.",
        "requires": [
          {
            "cond": {
              "ruledBy": "self"
            },
            "error": "Tenés que liderar el mercado"
          },
          {
            "cond": {
              "supply": "warriors"
            },
            "error": "No quedan ingenieros en la reserva"
          },
          {
            "cond": {
              "has": "warrior",
              "of": "rivalArmy"
            },
            "error": "No hay agentes rivales para adquirir"
          }
        ],
        "effects": [
          {
            "do": "convertWarrior",
            "log": "Adquirir: compra un agente de {victim} en {node}."
          }
        ]
      },
      "setup": [
        {
          "at": "corner",
          "warriors": 3
        },
        {
          "at": "cornerNeighbors",
          "warriors": 1
        },
        {
          "at": "corner",
          "building": true
        }
      ],
      "onTurnStart": [
        {
          "do": "placeWarriors",
          "where": {
            "has": "building",
            "of": "self"
          },
          "amount": 1,
          "log": "Planning — Autoescalado: +{n} ingenieros en los datacenters."
        }
      ],
      "onClose": [
        {
          "id": "monopolio",
          "vars": {
            "ruled": {
              "count": "nodes",
              "where": {
                "ruledBy": "self"
              }
            }
          },
          "vp": {
            "div": [
              {
                "ref": "ruled"
              },
              3
            ]
          },
          "why": "monopolio en {ruled} mercados (1 PV cada 3)"
        }
      ],
      "summary": [
        "Planning — Autoescalado: +1 ingeniero en cada mercado con datacenter.",
        "No contrata: crece sola desde sus datacenters.",
        "Construir datacenters da PV (1·2·2·3·3·4).",
        "Adquirir (1/turno): en un mercado que lidera, cambia 1 agente rival por uno propio.",
        "Cierre — Monopolio: +1 PV cada 3 mercados que lidera."
      ]
    },
    {
      "id": "meta",
      "name": "Meta AI",
      "short": "Meta",
