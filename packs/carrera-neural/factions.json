              ]
            },
            "error": "Necesitás una estructura o lanzamiento rival en el mercado"
          }
        ],
        "effects": [
          {
            "do": "log",
            "text": "Forkear: forkea el trabajo rival en {node}."
          },
          {
            "do": "gainVp",
            "amount": 1,
            "why": "fork"
          }
        ]
      },
      "setup": [
        {
          "at": "corner",
          "warriors": 4,
          "building": true
        }
      ],
      "onClose": [
        {
          "id": "estrellas",
          "vars": {
            "n": {
              "count": "nodes",
              "where": {
                "all": [
                  {
                    "ruledBy": "self"
                  },
                  {
                    "has": "building",
                    "of": "self"
                  }
                ]
              }
            }
          },
          "vp": {
            "ref": "n"
          },
          "why": "{n} repositorios con estrellas"
        }
      ],
      "summary": [
        "Viral: despliega hasta 2 conexiones por acción.",
        "Contratar: +2 contribuidores en un mercado con repositorio.",
        "Construir repositorios da PV (1·2·2).",
        "Forkear (1/turno): junto a una estructura o lanzamiento rival, +1 PV.",
        "Cierre — Estrellas: +1 PV por repositorio en mercado que lidera."
      ]
    },
